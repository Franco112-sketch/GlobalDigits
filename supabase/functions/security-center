
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.45.4";

const MODS = ["appvuln", "deps", "secrets", "network", "api"];
const SEV = ["Critical", "High", "Medium", "Low", "Informational"];
const ST = ["passed", "failed", "unverified"];

const cors = () => ({
  "Access-Control-Allow-Origin": Deno.env.get("ADMIN_ORIGIN") ?? "null",
  "Access-Control-Allow-Headers": "authorization, content-type, apikey",
  "Vary": "Origin",
});

const json = (o: unknown, s = 200) =>
  new Response(JSON.stringify(o), {
    status: s,
    headers: { ...cors(), "content-type": "application/json" },
  });

const hex = (b: ArrayBuffer) =>
  [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, "0")).join("");

const eq = (a: string, b: string) => {
  if (a.length !== b.length) return false;
  let d = 0;
  for (let i = 0; i < a.length; i++) {
    d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  }
  return d === 0;
};

const mask = (s: string) =>
  s
    .replace(/eyJ[\w-]{8,}\.[\w-]{8,}\.[\w-]{8,}/g, "eyJ…[masked-jwt]")
    .replace(/\b(sk|rk|pk)_(live|test)_[A-Za-z0-9]{8,}/g, "$1_$2_…[masked]")
    .replace(/\b[A-Za-z0-9_\-+/]{32,}\b/g, (m) =>
      m.slice(0, 4) + "…" + m.slice(-2) + "[masked]"
    );

const str = (v: unknown, n: number) =>
  mask(String(v ?? "").slice(0, n));

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: cors() });
  }

  if (req.method !== "POST") {
    return json({ error: "method" }, 405);
  }

  const path = new URL(req.url).pathname;

  if (path.endsWith("/ingest")) {
    const raw = await req.text();

    if (raw.length > 2_000_000) {
      return json({ error: "too large" }, 413);
    }

    const ts = req.headers.get("x-gsec-timestamp") ?? "";
    const sig = req.headers.get("x-gsec-signature") ?? "";
    const secret = Deno.env.get("SECURITY_INGEST_SECRET");

    const tms = Number(ts.length === 10 ? ts + "000" : ts);

    if (
      !secret ||
      !/^\d{10,13}$/.test(ts) ||
      Math.abs(Date.now() - tms) > 300_000
    ) {
      return json({ error: "unauthorized" }, 401);
    }

    const key = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"]
    );

    const mac = hex(
      await crypto.subtle.sign(
        "HMAC",
        key,
        new TextEncoder().encode(ts + "." + raw)
      )
    );

    if (!eq(mac, sig)) {
      return json({ error: "unauthorized" }, 401);
    }

    let p: any;

    try {
      p = JSON.parse(raw);
    } catch {
      return json({ error: "bad json" }, 400);
    }

    if (
      !MODS.includes(p.module) ||
      !p.external_id ||
      !Array.isArray(p.findings) ||
      !Array.isArray(p.checks) ||
      p.findings.length > 2000
    ) {
      return json({ error: "invalid payload" }, 400);
    }

    const clean = {
      module: p.module,
      external_id: str(p.external_id, 120),
      source: "github-actions",
      commit_sha: str(p.commit_sha, 40),
      started_at: p.started_at ?? null,
      summary: p.summary && typeof p.summary === "object" ? p.summary : {},
      checks: p.checks
        .filter((c: any) => ST.includes(c?.status))
        .map((c: any) => ({
          id: str(c.id, 60),
          status: c.status,
          detail: str(c.detail, 500),
        })),
      findings: p.findings
        .filter(
          (f: any) =>
            SEV.includes(f?.severity) &&
            f?.name &&
            f?.component &&
            f?.check_id
        )
        .map((f: any) => ({
          check_id: str(f.check_id, 60),
          name: str(f.name, 200),
          severity: f.severity,
          confirmed: f.confirmed === true,
          component: str(f.component, 300),
          evidence: str(f.evidence, 2000),
          description: str(f.description, 1500),
          fix: str(f.fix, 1000),
          reference: str(f.reference, 200),
        })),
    };

    const svc = createClient(
      Deno.env.get("SUPABASE_URL")!,
      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
    );

    const { data, error } = await svc.rpc("gsec_ingest", {
      p: clean,
    });

    return error
      ? json({ error: "ingest failed" }, 500)
      : json(data);
  }

  if (path.endsWith("/scan-now")) {
    const auth = req.headers.get("authorization") ?? "";

    const uc = createClient(
      Deno.env.get("SUPABASE_URL")!,
      Deno.env.get("SUPABASE_ANON_KEY")!,
      {
        global: {
          headers: { Authorization: auth },
        },
      }
    );

    const { data: u } = await uc.auth.getUser();

    if (!u?.user) {
      return json({ error: "unauthorized" }, 401);
    }

    const { data: ok, error } = await uc.rpc("gsec_request_scan");

    if (error) {
      return json({ error: "forbidden" }, 403);
    }

    if (!ok) {
      return json({
        error: "A scan was already requested in the last 2 minutes",
      }, 429);
    }

    const repo = Deno.env.get("GH_REPO");
    const tok = Deno.env.get("GH_DISPATCH_TOKEN");

    if (!repo || !tok) {
      return json({
        error: "GitHub dispatch not configured (GH_REPO / GH_DISPATCH_TOKEN)",
      }, 501);
    }

    const r = await fetch(
      `https://api.github.com/repos/${repo}/actions/workflows/security-scan.yml/dispatches`,
      {
        method: "POST",
        body: JSON.stringify({ ref: "main" }),
        headers: {
          Authorization: `Bearer ${tok}`,
          Accept: "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28",
        },
      }
    );

    return r.status === 204
      ? json({ queued: true })
      : json({
        error: "GitHub dispatch failed (" + r.status + ")",
      }, 502);
  }

  return json({ error: "not found" }, 404);
});
